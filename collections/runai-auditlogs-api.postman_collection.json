            "description": {
              "content": "Get audit logs based on query params filter",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "audit",
                "log"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "(Required) Start date of time range to fetch data in ISO 8601 timestamp format."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "(Required) End date of time range to fetch data in ISO 8601 timestamp format."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "The offset of the first item returned in the collection."
                },
                {
                  "disabled": false,
                  "key": "numberOfSamples",
                  "value": "20",
                  "description": "The number of samples to take in the specified time range."
                },
                {
                  "disabled": false,
                  "key": "sortOrder",
                  "value": "asc",
                  "description": "Sort results in descending or ascending order."
                },
                {
                  "disabled": false,
                  "key": "sortBy",
                  "value": "<string>",
                  "description": "Sort results by a parameters."
                },
                {
                  "disabled": false,
                  "key": "filterBy",
                  "value": "<string>,<string>",
                  "description": "Filter results by a parameter. Use the format field-name operator value. Operators are == Equals, != Not equals, <= Less than or equal, >= Greater than or equal, =@ contains, !@ Does not contains, =^ Starts with and =$ Ends with. Dates are in ISO 8601 timestamp format and available for operators ==, !=, <= and >=."
                }
              ],
              "variable": []
