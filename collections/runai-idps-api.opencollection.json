            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.run.ai/api/v1/idps"
          },
          "docs": "Get external idps list"
        },
        {
          "info": {
            "name": "Configure external idp",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.run.ai/api/v1/idps",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Configure external idp"
        },
        {
          "info": {
            "name": "Get external idp by alias",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.run.ai/api/v1/idps/:idp",
