          },
          "http": {
            "method": "GET",
            "url": "https://app.run.ai/api/v1/idps/:idp/mappers",
            "params": [
              {
                "name": "idp",
                "value": "",
                "type": "path",
                "description": "The alias of the idp"
              }
            ]
          },
          "docs": "Get idp mappers"
        },
        {
          "info": {
            "name": "Update idp mappers",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.run.ai/api/v1/idps/:idp/mappers",
            "params": [
              {
                "name": "idp",
                "value": "",
                "type": "path",
                "description": "The alias of the idp"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
