          },
          "http": {
            "method": "PUT",
            "url": "https://app.run.ai/api/v1/idps/:idp",
            "params": [
              {
                "name": "idp",
                "value": "",
                "type": "path",
                "description": "The alias of the idp"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update external idp by alias"
        },
        {
          "info": {
            "name": "Delete external idp by alias",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.run.ai/api/v1/idps/:idp",
            "params": [
              {
                "name": "idp",
                "value": "",
                "type": "path",
                "description": "The alias of the idp"
              }
            ]
          },
          "docs": "Delete external idp by alias"
        },
        {
          "info": {
            "name": "Get idp mappers",
