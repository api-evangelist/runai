  "item": [
    {
      "id": "e84000b8-9d2c-40d9-ab01-3445c3876205",
      "name": "Me",
      "description": {
        "content": "\"Me\" returns the authenticated user's permissions within the system. \nIt provides a comprehensive view of access rules (roles, subjects and scope) assigned to the current user.\nFor more information see [Access control](https://run-ai-docs.nvidia.com/saas/infrastructure-setup/authentication/overview/#role-based-access-control).\n",
        "type": "text/plain"
      },
