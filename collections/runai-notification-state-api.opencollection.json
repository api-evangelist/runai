{
  "opencollection": "1.0.0",
  "info": {
    "name": "NVIDIA Run:ai Access Keys Notification State API",
    "version": "latest"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Notification State",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get notification state",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.run.ai/api/v1/notification-state"
          },
          "docs": "Get notification state"
        },
        {
          "info": {
            "name": "Update notification state",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.run.ai/api/v1/notification-state",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update tenant notifications state"
        }
      ]
    }
  ],
  "bundled": true
}