{
  "item": [
    {
      "id": "1e19f204-ef69-4c45-9297-1569ef68d652",
      "name": "Tokens",
      "description": {
        "content": "Use tokens to facilitate authentication to the NVIDIA Run:ai API. \nThe API server must be configured to use the NVIDIA Run:ai identity \nservice to validate authentication tokens.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a10e3bcb-e027-47d6-b7c0-17f6e3f61aa0",
          "name": "Create an access token v1",
          "request": {
            "name": "Create an access token v1",
            "description": {
              "content": "Create tokens using the `grant_type` parameter.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grantType\": \"<string>\",\n  \"appID\": \"<string>\",\n  \"appSecret\": \"<string>\",\n  \"code\": \"<string>\",\n  \"redirectUri\": \"<string>\",\n  \"refreshToken\": \"<string>\",\n  \"username\": \"<string>\",\n  \"password\": \"<string>\",\n  \"clientID\": \"<string>\",\n  \"clientSecret\": \"<string>\",\n  \"externalToken\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
