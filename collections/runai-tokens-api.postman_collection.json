        {
          "id": "5c8ca442-b1e6-4011-ba03-6b06830a111d",
          "name": "Create an access token v2",
          "request": {
            "name": "Create an access token v2",
            "description": {
              "content": "Use this endpoint to obtain an access token. Compliant with standard OAuth2 protocol and supports the common OAuth2 grant types.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) The OAuth2 grant type that determines how the token will be issued."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "OAuth2 client identifier"
                },
                {
                  "disabled": false,
                  "key": "client_secret",
                  "value": "<password>",
                  "description": "OAuth2 client secret"
                },
                {
                  "disabled": false,
                  "key": "username",
                  "value": "<string>",
                  "description": "Resource owner username (for password grant)"
                },
                {
                  "disabled": false,
                  "key": "password",
                  "value": "<password>",
                  "description": "The password of the resource owner. Required only when using the password grant type."
                },
                {
                  "disabled": false,
                  "key": "refresh_token",
                  "value": "<string>",
                  "description": "The refresh token used to obtain a new access token. Required only when using the refresh_token grant type."
                },
                {
                  "disabled": false,
                  "key": "code",
                  "value": "<string>",
                  "description": "Authorization code issued by the authorization server. Used in the authorization_code grant to exchange the code for an access token."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<string>",
                  "description": "The redirect URI used during the authorization request. Required for the authorization_code grant to validate the redirect destination."
                }
              ]
            }
          },
          "response": [
            {
              "id": "ef9b5aa1-44e5-4163-aaec-7bbbbbfee51c",
              "name": "Successfully issued token",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "v2",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) The OAuth2 grant type that determines how the token will be issued.",
                        "type": "text/plain"
                      },
                      "key": "grant_type",
                      "value": "authorization_code"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "Authorization code issued by the authorization server. Used in the authorization_code grant to exchange the code for an access token.",
                        "type": "text/plain"
                      },
                      "key": "code",
                      "value": "authorization_code_value"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "The redirect URI used during the authorization request. Required for the authorization_code grant to validate the redirect destination.",
                        "type": "text/plain"
                      },
                      "key": "redirect_uri",
                      "value": "https://example.com/callback"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "OAuth2 client identifier",
                        "type": "text/plain"
                      },
                      "key": "client_id",
                      "value": "my-client-id"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"token_type\": \"Bearer\",\n  \"expires_in\": 3600,\n  \"refresh_token\": \"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"id_token\": \"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...\"\n}",
